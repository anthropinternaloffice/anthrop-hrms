# Anthrop HRMS — frontend environment
#
# Copy this file to .env.local and fill in the three values. .env.local is
# gitignored and must never be committed.
#
# Vite only exposes variables prefixed VITE_ to the browser. Everything in
# this file is therefore PUBLIC — it ships inside the JavaScript bundle.
# That is fine for the values below and fatal for anything else.
#
# The service_role key NEVER goes in this file, or in any file under
# frontend/. It bypasses every row-level security policy in the database.
# If it is ever pasted here, rotate it in Supabase immediately.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / public key.
# Safe in the browser: it carries no privileges of its own and is governed
# entirely by the row-level security policies proved in database/tests/.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# OPTIONAL, and normally left unset.
#
# The site address is read from the browser (window.location.origin) each
# time it is needed, so it is always correct on localhost, on a preview
# deployment, and after the move to hr.anthropmanagement.com — with no
# rebuild. An environment variable would be frozen into the JavaScript at
# build time and would go stale the moment the domain changed.
#
# Set this ONLY if the app is served from behind a proxy on a different
# public address than the browser sees. No trailing slash.
# VITE_SITE_URL=https://hr.anthropmanagement.com
