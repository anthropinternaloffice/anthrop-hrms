# Anthrop HRMS — frontend environment
#
# Copy this file to .env.local and fill in the three values. .env.local is
# gitignored and must never be committed.
#
# Vite only exposes variables prefixed VITE_ to the browser. Everything in
# this file is therefore PUBLIC — it ships inside the JavaScript bundle.
# That is fine for the values below and fatal for anything else.
#
# The service_role key NEVER goes in this file, or in any file under
# frontend/. It bypasses every row-level security policy in the database.
# If it is ever pasted here, rotate it in Supabase immediately.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / public key.
# Safe in the browser: it carries no privileges of its own and is governed
# entirely by the row-level security policies proved in database/tests/.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where this deployment lives, with no trailing slash. Password reset emails
# link back here. It is a variable and not a constant because the address
# changes: a .pages.dev address now, hr.anthropmanagement.com later.
#   local        http://localhost:5173
#   preview      https://anthrop-hrms.pages.dev
VITE_SITE_URL=http://localhost:5173
